{
  "name": "support-agent",
  "description": "ProjectTogether's open-source support agent for Slack",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "author": "ProjectTogether gGmbH",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/projecttogether/support-agent.git"
  },
  "private": true,
  "type": "module",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @support-agent/server & npm run dev --workspace @support-agent/web & wait",
    "dev:server": "npm run dev --workspace @support-agent/server",
    "dev:web": "npm run dev --workspace @support-agent/web",
    "build": "npm run build --workspace @support-agent/web && npm run build --workspace @support-agent/server",
    "start": "npm run start --workspace @support-agent/server",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace @support-agent/server",
    "db:generate": "npm run db:generate --workspace @support-agent/server",
    "db:migrate": "npm run db:migrate --workspace @support-agent/server",
    "cli": "npm run --silent cli --workspace @support-agent/server --"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "sentry": "0.50.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.28.2"
    }
  }
}
